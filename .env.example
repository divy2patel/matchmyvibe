# ═══════════════════════════════════════════════════════════════════════════════
# MATCHMYVIBE V2 — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. AI Provider Orchestration (Primary: Gemini, Fallback: Groq) ───────────
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# Google Gemini (Primary Provider)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Groq (Automatic Failover Provider)
# Get key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── 2. Supabase PostgreSQL & Auth ────────────────────────────────────────────
# Get credentials from: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── 3. Backend Service URLs ──────────────────────────────────────────────────
# FastAPI backend URL (Used by Next.js API client)
FASTAPI_BACKEND_URL=http://localhost:8000
PORT=8000

# Next.js frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
